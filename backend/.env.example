# WorkNest HRMS - FastAPI Backend Environment Configuration

# PostgreSQL Connection URL
# Provide your PostgreSQL credentials below:
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/worknest_hrms

# Fallback to local SQLite when DATABASE_URL is unset:
# DATABASE_URL=sqlite:///./hrms.db

# JWT Security
SECRET_KEY=worknest-hrms-secure-jwt-secret-key-prod-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# App Settings
PROJECT_NAME="WorkNest HRMS API"
VERSION="3.0.0"
